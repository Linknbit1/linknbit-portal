# ─────────────────────────────────────────────────────────────
# Linknbit Portal — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────
# Remote project: https://supabase.com/dashboard/project/pifsboyhheazpccyliwy/settings/api
# Local dev: run `supabase start` and copy the output values
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── ClickUp (configured in Settings UI — stored in Supabase Vault) ─
# These are NOT used by the frontend directly.
# The Edge Functions read them from Vault via the Supabase service role.
# Add them to your Supabase project's Edge Function secrets:
#   supabase secrets set CLICKUP_API_TOKEN=your_token
# CLICKUP_API_TOKEN=
# CLICKUP_WEBHOOK_SECRET=

# ── Discord (configured in Settings UI — stored in Supabase Vault) ─
# Same as ClickUp: stored in Vault, not used directly by frontend.
#   supabase secrets set DISCORD_WEBHOOK_URL=your_url
# DISCORD_WEBHOOK_URL=

# ── Supabase Service Role (Edge Functions only — NEVER in frontend) ─
# Used only in Supabase Edge Functions and CI/CD.
# Never prefix with VITE_ — Vite would expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Local dev extras (optional) ──────────────────────────────
# Supabase Studio AI assistant (optional, only used locally)
# OPENAI_API_KEY=
